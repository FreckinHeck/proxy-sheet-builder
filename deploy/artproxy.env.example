# Copy to artproxy.env and fill in. Never commit the filled-in copy.

# Required if the proxy is reachable from the internet. Every request must
# carry ?k=<this>. It is readable in the page source, so it is a bandwidth
# gate, not a security boundary — treat it as public and rotate it freely.
PROXY_TOKEN=generate-with-openssl-rand-hex-24

# Separate and genuinely secret. Only this token can list or read submitted
# orders. Never put it in proxy-config.json or anywhere the page can see.
ADMIN_TOKEN=generate-with-openssl-rand-hex-24

# Optional. A Discord (or Slack) webhook pinged when an order is submitted.
# WEBHOOK_URL=

# Paths inside the container.
CACHE_DIR=/cache
ORDERS_DIR=/orders

# Tuning. Google Drive throttles parallel fetches of full-size files, so the
# full-file lane stays narrow while thumbnails get their own wider lane.
PORT=8778
CONCURRENCY=4
THUMB_CONCURRENCY=12
CACHE_MAX_MB=4096
THUMB_WIDTH=400
THUMB_MAX=900
THUMB_QUALITY=82
